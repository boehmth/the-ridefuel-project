# === Google OAuth (Login) ===
# Erstelle ein OAuth-Client in der Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=deine_google_client_id
GOOGLE_CLIENT_SECRET=dein_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# === JWT-Session ===
# Geheimer Schlüssel für die Session-Tokens (unbedingt ändern!)
JWT_SECRET=dev-secret-change-me

# === KI-Provider ===
# DeepSeek
DEEPSEEK_API_KEY=dein_deepseek_key
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini
GOOGLE_API_KEY=dein_google_key
GEMINI_MODEL=models/gemini-flash-latest

# === Strava ===
STRAVA_CLIENT_ID=deine_client_id
STRAVA_CLIENT_SECRET=dein_client_secret
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback

# === Google Cloud Storage (SQLite-Persistenz) ===
# Lokal standardmäßig deaktiviert. In Cloud Run auf "true" setzen.
GCS_SQLITE_ENABLED=false
GCS_SQLITE_BUCKET=ridefuel-sqlite-gen-lang-client-0462444162
GCS_SQLITE_OBJECT=trainingsplanner.db
GCS_SQLITE_SYNC_INTERVAL_SECONDS=30


